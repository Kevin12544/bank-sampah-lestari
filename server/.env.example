# Salin ke .env untuk menjalankan backend secara lokal.
# Ambil connection string PostgreSQL dari Supabase > Project Settings > Database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
CLIENT_URL=http://localhost:5173
DEMO_PASSWORD=ganti-password-demo-ini
PORT=4000
